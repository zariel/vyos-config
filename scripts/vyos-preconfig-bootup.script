#!/bin/sh
# This script is executed before VyOS loads its configuration.

# Preserve the existing bind container directory setup.
mkdir -p /tmp/bind/cache
chown -R 100 /tmp/bind/cache

# COM1 (ttyS0) is the break-glass console on Avocent port 2 at 115200. The
# kernel console is tty0 only, so nothing else sets the UART's speed, and the
# serial getty's --keep-baud would otherwise keep its 9600 power-on default.
stty -F /dev/ttyS0 115200 || true

# VyOS 1.4 incorrectly requires both address families on every mDNS interface
# in "both" mode. Avahi supports mixed links, including IPv6-only Matter VLANs.
# Reapply the small validator fix before startup configuration is validated.
mdns_script=/usr/libexec/vyos/conf_mode/service_mdns_repeater.py
mdns_patch=/config/scripts/patches/mdns-mixed-address-families.patch
if ! patch --dry-run -R "$mdns_script" "$mdns_patch" >/dev/null 2>&1; then
    patch -N "$mdns_script" "$mdns_patch"
    # configd starts before this hook and preloads configuration modules.
    systemctl restart vyos-configd.service
fi

# Keep the IPv4 IGMP querier supervised alongside the existing FRR daemons.
# VyOS 1.4 otherwise renders pimd=no even with protocols pim configured.
frr_template=/usr/share/vyos/templates/frr/daemons.frr.tmpl
frr_pimd_patch=/config/scripts/patches/frr-enable-pimd.patch
if ! patch --dry-run -R "$frr_template" "$frr_pimd_patch" >/dev/null 2>&1; then
    patch -N "$frr_template" "$frr_pimd_patch" || exit 1
fi

# VyOS initially renders /etc/frr/daemons and starts FRR before this hook.
# Reconcile even if the template was already patched but the daemon file is
# stale. The native handler applies changes during boot, before configuration
# loading; on a running router it leaves the FRR restart/reload to the operator.
/usr/libexec/vyos/conf_mode/system_frr.py || exit 1
